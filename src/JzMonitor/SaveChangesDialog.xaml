<Window x:Class="JzMonitor.SaveChangesDialog"
        Icon="pack://application:,,,/JzMonitor;component/Assets/JzMonitor.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:JzMonitor.Controls"
        Title="Save changes?" Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Відступ під тінь -->
    <Border Margin="16" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="12" MouseLeftButtonDown="Drag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#1D2430"/>
        </Border.Effect>
        <StackPanel Margin="24,22,24,20">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="#1AF26B1D" VerticalAlignment="Top">
                    <c:VectorIcon Kind="Save" Size="18" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="Save changes?" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Reason" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Підсумок запису -->
            <Border Background="{DynamicResource Panel2}" CornerRadius="8" Padding="14,10" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="RECORDING" Style="{StaticResource Caption}" FontSize="10" Margin="0,0,16,0"/>
                    <TextBlock x:Name="FileText" Grid.Column="1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Text="FRAMES" Style="{StaticResource Caption}" FontSize="10" Margin="0,6,16,0"/>
                    <TextBlock x:Name="FramesText" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Text="TIME" Style="{StaticResource Caption}" FontSize="10" Margin="0,6,16,0"/>
                    <TextBlock x:Name="TimeText" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"/>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancel" IsCancel="True" MinWidth="90" Click="Cancel_Click"/>
                <Button Content="Don't save" MinWidth="100" Click="Discard_Click"/>
                <Button Content="Save" IsDefault="True" MinWidth="90" Margin="0" Style="{StaticResource AccentButton}" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
