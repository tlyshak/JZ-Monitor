<Window x:Class="JzMonitor.CompareWindow"
        Icon="pack://application:,,,/JzMonitor;component/Assets/JzMonitor.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:JzMonitor.Controls"
        Title="Compare recordings" Height="900" Width="1360" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Власний заголовок, як у головному вікні: верхній рядок — заголовок вікна -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Картка файлу: назва, відкриття, діапазон -->
        <DataTemplate x:Key="SideTemplate">
            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,12,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13" Background="{Binding Badge}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button DockPanel.Dock="Right" Command="{Binding OpenCommand}" Margin="0" AutomationProperties.Name="{Binding Label, StringFormat=Open {0}}">
                            <StackPanel Orientation="Horizontal">
                                <c:VectorIcon Kind="Open"/>
                                <TextBlock Text="Open…" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="10,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Info}" Style="{StaticResource Caption}" FontWeight="Normal" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="RANGE" Style="{StaticResource Caption}" Margin="0,0,10,0"/>
                        <ComboBox Width="86" ItemsSource="{Binding RangeModes}" SelectedIndex="{Binding RangeModeIndex}"/>
                        <TextBlock Text="from" Style="{StaticResource FieldLabel}" Margin="10,0,6,0"/>
                        <TextBox Width="78" AutomationProperties.Name="{Binding Label, StringFormat={}{0} from}" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="to" Style="{StaticResource FieldLabel}" Margin="8,0,6,0"/>
                        <TextBox Width="78" AutomationProperties.Name="{Binding Label, StringFormat={}{0} to}" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Apply" AutomationProperties.Name="{Binding Label, StringFormat=Apply {0}}" Command="{Binding ApplyCommand}" Margin="8,0,6,0" Style="{StaticResource AccentButton}"/>
                        <Button Content="Full" Command="{Binding FullCommand}" Margin="0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" FontSize="11" Margin="0,6,0,0"
                               Visibility="{Binding Error, Converter={x:Static c:Inverse.EmptyToCollapsed}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Рядок підсумків поїздки: назва, A, B, різниця, одиниця -->
        <DataTemplate x:Key="TripRowTemplate">
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Height="25" Padding="4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding A}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding B}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding Delta}" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding Unit}" Foreground="{DynamicResource TextDim}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Рядок таблиці: параметр, A, B, різниця, статистика -->
        <DataTemplate x:Key="RowTemplate">
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Height="25" Padding="4,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource BoxCheck}" Tag="{Binding ColorBrush}" IsChecked="{Binding Charted}" VerticalAlignment="Center"
                              ToolTip="Show on chart (A solid, B dashed)" Visibility="{Binding Chartable, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding A}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding B}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding Delta}" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="{Binding Unit}" Foreground="{DynamicResource TextDim}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="{Binding AStats}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="7" Text="{Binding BStats}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ═══ Заголовок ═══ -->
        <Border DockPanel.Dock="Top" Height="44" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <c:CaptionButtons DockPanel.Dock="Right"/>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Accent}">
                        <TextBlock Text="JZ" FontWeight="Black" FontSize="11" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Compare recordings" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="16,12,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="220"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Файли A і B -->
            <UniformGrid Columns="2" Margin="0,0,-12,12">
                <ContentControl Content="{Binding SideA}" ContentTemplate="{StaticResource SideTemplate}"/>
                <ContentControl Content="{Binding SideB}" ContentTemplate="{StaticResource SideTemplate}"/>
            </UniformGrid>

            <!-- Графік -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10,14,14" Margin="0,0,0,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="TREND" Style="{StaticResource SectionTitle}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="A solid · B dashed · time from the start of each range" Style="{StaticResource Caption}" FontWeight="Normal"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CursorInfo}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </DockPanel>
                    <c:ChartControl x:Name="Chart" Series="{Binding Chart}" CursorIndex="{Binding ChartCursor, Mode=OneWay}" XLabel="{Binding ChartXLabel}"/>
                </DockPanel>
            </Border>

            <!-- Таблиця: параметри ліворуч, підсумки поїздки праворуч — так графіку лишається більше місця -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,8,14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Grid Margin="4,0,4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="AT CURSOR" Style="{StaticResource Caption}" FontSize="10"/>
                            <TextBlock Grid.Column="2" Text="A" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="B" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="B − A" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="6" Text="A  MIN / AVG / MAX" Style="{StaticResource Caption}" FontSize="10" Margin="10,0,0,0"/>
                            <TextBlock Grid.Column="7" Text="B  MIN / AVG / MAX" Style="{StaticResource Caption}" FontSize="10" Margin="10,0,0,0"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Grid Margin="4,0,4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TRIP  (whole range)" Style="{StaticResource Caption}" FontSize="10"/>
                            <TextBlock Grid.Column="1" Text="A" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="B" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="B − A" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TripRows}" ItemTemplate="{StaticResource TripRowTemplate}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
