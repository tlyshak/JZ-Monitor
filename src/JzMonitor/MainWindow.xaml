<Window x:Class="JzMonitor.MainWindow"
        Icon="pack://application:,,,/JzMonitor;component/Assets/JzMonitor.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:JzMonitor.Controls"
        Title="{Binding Title}" Height="920" Width="1440" MinWidth="1100" MinHeight="760"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Власний заголовок: верхній рядок програми — це і є заголовок вікна (перетягування, подвійний клік) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Плитка параметра (компактна, 8 в ряд) -->
        <DataTemplate x:Key="TileTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="14,10,14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource BoxCheck}" Tag="{Binding ColorBrush}"
                                  IsChecked="{Binding Charted}" ToolTip="Show on chart"/>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="0,2,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Text}" FontSize="26" FontWeight="Normal"/>
                            <TextBlock Text="{Binding Unit}" Foreground="{DynamicResource TextDim}" FontSize="12"
                                       VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" ToolTip="This session, engine running">
                            <TextBlock Text="MIN" Style="{StaticResource Caption}" FontSize="9" Margin="0,0,4,0"
                                       Visibility="{Binding ShowMin, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding MinText}" Foreground="{DynamicResource TextDim}" FontSize="11" FontWeight="SemiBold" Margin="0,0,12,0"
                                       Visibility="{Binding ShowMin, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="MAX" Style="{StaticResource Caption}" FontSize="9" Margin="0,0,4,0"
                                       Visibility="{Binding ShowMax, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding MaxText}" Foreground="{DynamicResource TextDim}" FontSize="11" FontWeight="SemiBold"
                                       Visibility="{Binding ShowMax, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="2" Height="3">
                        <Border CornerRadius="2" Background="{DynamicResource Panel3}"/>
                        <Border CornerRadius="2" Background="{Binding Accent}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Fraction}"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Біт стану ECU: рядок таблиці у дві колонки -->
        <DataTemplate x:Key="FlagTemplate">
            <Border x:Name="Row" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Height="25" Margin="0,0,14,0"
                    Padding="2,0" Background="Transparent" ToolTip="{Binding BitLabel, StringFormat='Bit {0}'}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="Led" Width="8" Height="8" Fill="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="{Binding BitLabel}" Foreground="{DynamicResource TextDim}" FontFamily="{StaticResource MonoFont}"
                               FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Name" Grid.Column="2" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="State" Grid.Column="3" Text="{Binding Text}" Foreground="{DynamicResource TextDim}" FontWeight="SemiBold"
                               FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter TargetName="Led" Property="Fill" Value="{DynamicResource Ok}"/>
                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Ok}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsOn}" Value="True"/>
                        <Condition Binding="{Binding IsAlarm}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Led" Property="Fill" Value="{DynamicResource Danger}"/>
                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Danger}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding HiddenInOriginal}" Value="True">
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextDim}"/>
                    <Setter TargetName="Row" Property="ToolTip" Value="Not shown by CarTester; never set on the reference 2JZ-GTE"/>
                </DataTrigger>
                <!-- Попередження: застрягла лямбда, концевик ХХ при закритій заслінці -->
                <DataTrigger Binding="{Binding Warning}" Value="Warn">
                    <Setter TargetName="Led" Property="Fill" Value="{DynamicResource Caution}"/>
                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Caution}"/>
                    <Setter TargetName="Row" Property="ToolTip" Value="{Binding WarningText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Warning}" Value="Alarm">
                    <Setter TargetName="Led" Property="Fill" Value="{DynamicResource Danger}"/>
                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource Danger}"/>
                    <Setter TargetName="Row" Property="ToolTip" Value="{Binding WarningText}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Рядок таблиці параметрів (дві колонки) -->
        <DataTemplate x:Key="ParamTemplate">
            <Border x:Name="Row" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="4,0" Height="27" Margin="0,0,16,0"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource BoxCheck}" Tag="{Binding ColorBrush}" VerticalAlignment="Center"
                              IsChecked="{Binding Charted}" ToolTip="Show on chart"
                              Visibility="{Binding Chartable, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding Text}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                               ToolTip="{Binding Raw, StringFormat='raw {0}'}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Unit}" Foreground="{DynamicResource TextDim}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding MinText}" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Minimum this session (engine running)"/>
                    <TextBlock Grid.Column="5" Text="{Binding MaxText}" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Maximum this session (engine running)"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HiddenInOriginal}" Value="True">
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Warn}"/>
                    <Setter TargetName="Row" Property="ToolTip" Value="Not shown by the original CarTester"/>
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHover}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Заголовок (він же заголовок вікна) ═══ -->
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <DockPanel>
            <!-- Кнопки вікна -->
            <c:CaptionButtons DockPanel.Dock="Right" Margin="12,0,0,0"/>
            <DockPanel LastChildFill="False" Margin="16,10,0,10">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource Accent}">
                        <TextBlock Text="JZ" FontWeight="Black" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="JZ MONITOR" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="{Binding FileTitle}" Style="{StaticResource Caption}" FontWeight="Normal" Margin="10,1,0,0"
                                       MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileTitle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding VehicleSummary}" Style="{StaticResource Caption}"
                                   FontWeight="Normal" Margin="0,1,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">

                    <Button AutomationProperties.Name="New recording" Style="{StaticResource GhostButton}" Command="{Binding NewCommand}" ToolTip="New recording">
                        <c:VectorIcon Kind="Add"/>
                    </Button>
                    <Button AutomationProperties.Name="Open recording (.ctr)" Style="{StaticResource GhostButton}" Command="{Binding OpenCommand}" ToolTip="Open recording (.ctr)">
                        <c:VectorIcon Kind="Open"/>
                    </Button>
                    <Button AutomationProperties.Name="Save recording (.ctr)" Style="{StaticResource GhostButton}" Command="{Binding SaveCommand}" ToolTip="Save recording (.ctr)">
                        <c:VectorIcon Kind="Save"/>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource Border}" Margin="8,6"/>
                    <Button AutomationProperties.Name="Export to CSV (Excel)" Style="{StaticResource GhostButton}" Command="{Binding ExportCsvCommand}" ToolTip="Export to CSV (Excel)">
                        <StackPanel Orientation="Horizontal">
                            <c:VectorIcon Kind="Table"/>
                            <TextBlock Text="CSV" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Recording report" Style="{StaticResource GhostButton}" Command="{Binding ReportCommand}"
                            ToolTip="Report: warm idle, warm-up, checks, trip — compared with the reference recording">
                        <StackPanel Orientation="Horizontal">
                            <c:VectorIcon Kind="Report"/>
                            <TextBlock Text="Report" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Compare two recordings" Style="{StaticResource GhostButton}" Command="{Binding CompareCommand}" ToolTip="Compare two recordings">
                        <StackPanel Orientation="Horizontal">
                            <c:VectorIcon Kind="Compare"/>
                            <TextBlock Text="Compare" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Vehicle info and notes" Style="{StaticResource GhostButton}" Command="{Binding VehicleCommand}" ToolTip="Vehicle info and notes">
                        <StackPanel Orientation="Horizontal">
                            <c:VectorIcon Kind="Car"/>
                            <TextBlock Text="Vehicle" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Тема: світла / середня (для сонця) / темна -->
                    <Button AutomationProperties.Name="Switch theme" Style="{StaticResource GhostButton}" Command="{Binding NextThemeCommand}"
                            ToolTip="{Binding ThemeTip}" Margin="0,0,14,0">
                        <c:VectorIcon Kind="{Binding ThemeIcon}"/>
                    </Button>
                    <TextBlock Text="PORT" Style="{StaticResource Caption}" Margin="0,0,8,0"/>
                    <ComboBox Width="96" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"
                              IsEnabled="{Binding IsRunning, Converter={x:Static c:Inverse.Bool}}"/>
                    <Button AutomationProperties.Name="Refresh port list" Style="{StaticResource GhostButton}" Command="{Binding RefreshPortsCommand}" ToolTip="Refresh port list" Margin="4,0,8,0">
                        <c:VectorIcon Kind="Refresh"/>
                    </Button>
                    <Button AutomationProperties.Name="Connect" Style="{StaticResource AccentButton}" Command="{Binding StartCommand}" MinWidth="110" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <c:VectorIcon Kind="{Binding StartIcon}" Size="12"/>
                            <TextBlock Text="{Binding StartText}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Стан зв'язку -->
                    <!-- Видно лише під час читання з порту -->
                    <Border x:Name="Pill" CornerRadius="13" Padding="12,5" Margin="10,0,0,0" BorderThickness="1"
                            VerticalAlignment="Center" MinWidth="100" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Panel2}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                                <Setter Property="Tag" Value="{DynamicResource TextDim}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Link}" Value="Live">
                                        <Setter Property="Background" Value="#1418A866"/>
                                        <Setter Property="BorderBrush" Value="#6618A866"/>
                                        <Setter Property="Tag" Value="{DynamicResource Ok}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Link}" Value="Waiting">
                                        <Setter Property="Background" Value="#14C98A00"/>
                                        <Setter Property="BorderBrush" Value="#66C98A00"/>
                                        <Setter Property="Tag" Value="{DynamicResource Warn}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Link}" Value="Errors">
                                        <Setter Property="Background" Value="#14E5484D"/>
                                        <Setter Property="BorderBrush" Value="#66E5484D"/>
                                        <Setter Property="Tag" Value="{DynamicResource Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{Binding Tag, ElementName=Pill}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LinkText}" Foreground="{Binding Tag, ElementName=Pill}" FontWeight="Bold"
                                       FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Основна область ═══ -->
        <Grid Grid.Row="1" Margin="16,8,16,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="220"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="262"/>
            </Grid.RowDefinitions>

            <!-- Графік на всю ширину; кнопка Range замість графіка показує огляд усього запису для вибору діапазону -->
            <Border Style="{StaticResource Card}" Padding="14,10,14,14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="TREND" Style="{StaticResource SectionTitle}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button AutomationProperties.Name="Select range" Command="{Binding ToggleRangePanelCommand}" Padding="10,4" Margin="0,0,8,0"
                                    ToolTip="Choose the range to view: drag on the whole recording">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RangePanelOpen}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Panel2}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding TrendVisible, Converter={StaticResource BoolToVis}}">
                                        <c:VectorIcon Kind="Filter" Size="12"/>
                                        <TextBlock Text="Range" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding RangePanelOpen, Converter={StaticResource BoolToVis}}">
                                        <c:VectorIcon Kind="Check" Size="12"/>
                                        <TextBlock Text="Done" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Border CornerRadius="9" Padding="10,2,4,2" Margin="0,0,10,0" Background="{DynamicResource Panel2}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1" VerticalAlignment="Center"
                                    Visibility="{Binding IsRangeSet, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding RangeInfo}" Style="{StaticResource Caption}" FontWeight="Normal" VerticalAlignment="Center"/>
                                    <Button AutomationProperties.Name="Show the whole recording" Style="{StaticResource GhostButton}" Command="{Binding FullRangeCommand}"
                                            ToolTip="Show the whole recording" Padding="4,0" Margin="4,0,0,0">
                                        <c:VectorIcon Kind="Cancel" Size="10"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasMarks, Converter={StaticResource BoolToVis}}">
                                <Button AutomationProperties.Name="Previous marked frame" Style="{StaticResource GhostButton}" Command="{Binding PrevMarkCommand}"
                                        ToolTip="Previous marked frame" Padding="4,6">
                                    <c:VectorIcon Kind="ChevronLeft" Size="10" Foreground="{DynamicResource Warn}"/>
                                </Button>
                                <TextBlock Text="{Binding MarkCount}" Foreground="{DynamicResource Warn}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           ToolTip="Marked frames in the recording"/>
                                <Button AutomationProperties.Name="Next marked frame" Style="{StaticResource GhostButton}" Command="{Binding NextMarkCommand}"
                                        ToolTip="Next marked frame" Padding="4,6">
                                    <c:VectorIcon Kind="ChevronRight" Size="10" Foreground="{DynamicResource Warn}"/>
                                </Button>
                            </StackPanel>
                            <Button AutomationProperties.Name="Mark / unmark this frame" Style="{StaticResource GhostButton}" Command="{Binding ToggleMarkCommand}" ToolTip="Mark / unmark this frame">
                                <c:VectorIcon>
                                    <c:VectorIcon.Style>
                                        <Style TargetType="c:VectorIcon">
                                            <Setter Property="Kind" Value="Star"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FrameMarked}" Value="True">
                                                    <Setter Property="Kind" Value="StarFilled"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </c:VectorIcon.Style>
                                </c:VectorIcon>
                            </Button>
                            <Button AutomationProperties.Name="Delete this frame" Style="{StaticResource GhostButton}" Command="{Binding DeleteFrameCommand}" ToolTip="Delete this frame">
                                <c:VectorIcon Kind="Delete"/>
                            </Button>
                        </StackPanel>
                        <Button DockPanel.Dock="Left" AutomationProperties.Name="Previous frame" Style="{StaticResource GhostButton}" Command="{Binding PrevCommand}" ToolTip="Previous frame">
                            <c:VectorIcon Kind="ChevronLeft" Size="12"/>
                        </Button>
                        <Button DockPanel.Dock="Left" AutomationProperties.Name="Next frame" Style="{StaticResource GhostButton}" Command="{Binding NextCommand}" ToolTip="Next frame">
                            <c:VectorIcon Kind="ChevronRight" Size="12"/>
                        </Button>
                        <Button DockPanel.Dock="Left" AutomationProperties.Name="Jump to latest frame and follow" Style="{StaticResource GhostButton}" Command="{Binding LatestCommand}" ToolTip="Jump to latest frame and follow">
                            <c:VectorIcon Kind="Latest" Size="12"/>
                        </Button>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FrameNumber, StringFormat='Frame {0}'}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding FrameTime}" Style="{StaticResource Caption}" FontWeight="Normal" Margin="12,0,0,0"/>
                            <Border CornerRadius="9" Padding="8,2" Margin="12,0,0,0" Background="{DynamicResource Panel2}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1" VerticalAlignment="Center"
                                    Visibility="{Binding EngineOff, Converter={StaticResource BoolToVis}}"
                                    ToolTip="RPM is 0 in this frame — injection time and ignition advance are not meaningful and are hidden">
                                <TextBlock Text="ENGINE OFF" Style="{StaticResource Caption}" FontSize="10"/>
                            </Border>
                        </StackPanel>
                        <Slider Minimum="{Binding RangeLo}" Maximum="{Binding RangeHi}" Value="{Binding CurrentIndex}" IsSnapToTickEnabled="True"
                                TickFrequency="1" SmallChange="1" LargeChange="10" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </DockPanel>
                    <Grid>
                        <c:ChartControl x:Name="Chart" Series="{Binding Chart}" CursorIndex="{Binding ChartCursor, Mode=OneWay}" XLabel="{Binding ChartXLabel}" Marks="{Binding ChartMarks}" Alerts="{Binding ChartAlerts}"
                                        Visibility="{Binding TrendVisible, Converter={StaticResource BoolToVis}}"/>
                        <c:ChartControl x:Name="Overview" DragSelects="True" Series="{Binding Overview}" CursorIndex="{Binding OverviewCursor, Mode=OneWay}"
                                        SelectionStart="{Binding OverviewSelStart, Mode=OneWay}" SelectionEnd="{Binding OverviewSelEnd, Mode=OneWay}"
                                        XLabel="{Binding OverviewXLabel}" Marks="{Binding OverviewMarks}" Alerts="{Binding OverviewAlerts}" AutomationProperties.Name="Whole recording overview"
                                        Visibility="{Binding RangePanelOpen, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Плитки — один ряд -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}" Margin="0,6,-6,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- Низ: стан ECU + вкладки -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" MinWidth="330"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="14,12,14,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ECU STATUS" Style="{StaticResource SectionTitle}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Flags}" ItemTemplate="{StaticResource FlagTemplate}" Margin="0,0,-14,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,4,14,10">
                    <TabControl Padding="0,8,0,0">
                        <TabItem Header="Parameters">
                            <DockPanel>
                            <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,-16,2">
                                <Grid Margin="0,0,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="62"/><ColumnDefinition Width="58"/><ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="PARAMETER" Style="{StaticResource Caption}" FontSize="10"/>
                                    <TextBlock Grid.Column="2" Text="NOW" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="MIN" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="5" Text="MAX" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                </Grid>
                                <Grid Margin="0,0,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/><ColumnDefinition Width="62"/><ColumnDefinition Width="58"/><ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="PARAMETER" Style="{StaticResource Caption}" FontSize="10"/>
                                    <TextBlock Grid.Column="2" Text="NOW" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="MIN" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="5" Text="MAX" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                </Grid>
                            </UniformGrid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Analog}" ItemTemplate="{StaticResource ParamTemplate}" Margin="0,0,-16,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="Frame">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel MinWidth="260">
                                    <TextBlock Text="CURRENT FRAME" Style="{StaticResource SectionTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="ID" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding IdInfo}" FontFamily="{StaticResource MonoFont}"/>
                                        <TextBlock Grid.Row="1" Text="BYTES" Style="{StaticResource FieldLabel}" Margin="0,8,10,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ByteCount}" Margin="0,8,0,0"/>
                                        <TextBlock Grid.Row="2" Text="DATA" Style="{StaticResource FieldLabel}" Margin="0,8,10,0" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HexInfo}" FontFamily="{StaticResource MonoFont}"
                                                   TextWrapping="Wrap" MaxWidth="250" HorizontalAlignment="Left" Margin="0,8,0,0" Foreground="{DynamicResource Accent}"/>
                                    </Grid>
                                </StackPanel>
                                <DockPanel Grid.Column="2">
                                    <TextBlock DockPanel.Dock="Top" Text="RECEIVED FRAMES  (newest first)" Style="{StaticResource SectionTitle}"/>
                                    <ListBox ItemsSource="{Binding RawLog}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="2,2"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </DockPanel>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Setup">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="INJECTORS  (fuel flow estimate)" Style="{StaticResource SectionTitle}"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,4">
                                            <StackPanel Margin="0,0,8,0" ToolTip="Flow of one injector. JDM 2JZ-GTE non-VVTi stock: 440 cc/min (US: 550)">
                                                <TextBlock Text="Flow, cc/min" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding InjectorFlowCcMin}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,0" ToolTip="Number of injectors">
                                                <TextBlock Text="Injectors" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding InjectorCount}"/>
                                            </StackPanel>
                                            <StackPanel ToolTip="How many times each injector fires per 2 crank revolutions: 1 = sequential (2JZ-GTE), 2 = group / simultaneous">
                                                <TextBlock Text="Shots / 2 rev" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding InjectionRate}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="Approximate: injector dead time is not taken into account." Style="{StaticResource Caption}"
                                                   FontWeight="Normal" FontSize="11" Margin="0,0,0,14"/>

                                        <TextBlock Text="SPEED" Style="{StaticResource SectionTitle}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14"
                                                    ToolTip="Vehicle speed = raw byte ÷ this value. CarTester shows the raw byte (÷1); 3.4 matches the real speed on the reference Chaser">
                                            <TextBlock Text="Speed ÷" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding SpeedDivisor}" Width="70"/>
                                            <TextBlock Text="raw byte ÷ value = km/h" Style="{StaticResource Caption}" FontWeight="Normal" FontSize="11" Margin="10,0,0,0"/>
                                        </StackPanel>

                                        <TextBlock Text="MAP" Style="{StaticResource SectionTitle}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14"
                                                    ToolTip="MAP scale: kPa per raw count (CarTester: 0.97). Shown relative to standard atmosphere 101.3 kPa — change only after checking with a gauge">
                                            <TextBlock Text="kPa per count" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding MapKpaPerCount}" Width="70"/>
                                        </StackPanel>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PROTOCOL" Style="{StaticResource SectionTitle}"/>
                                        <UniformGrid Columns="3" Margin="0,0,0,14">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Bit time, ms" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding BitTimeMs}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Gap, bits" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding GapBits}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Min bytes" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding MinDataBytes}"/>
                                            </StackPanel>
                                        </UniformGrid>

                                        <TextBlock Text="CHECKS" Style="{StaticResource SectionTitle}"/>
                                        <CheckBox Content="O2 stuck: warn from 10 s (default 20 s)" IsChecked="{Binding ShowShortO2Stuck}" Margin="0,0,0,4"
                                                  ToolTip="Short O2 stalls (10–20 s) happen on a healthy engine during transients; off = only 20 s and longer"/>
                                        <CheckBox Content="Idle switch open at 0 % throttle: warn from 2 s (default 5 s)" IsChecked="{Binding ShowShortIdlMismatch}" Margin="0,0,0,14"
                                                  ToolTip="Off = only mismatches longer than 5 s"/>

                                        <TextBlock Text="TOOLS" Style="{StaticResource SectionTitle}"/>
                                        <CheckBox Content="Show data hidden by CarTester" IsChecked="{Binding ShowHidden}" Margin="0,0,0,4"/>
                                        <CheckBox Content="Log raw edges to file" IsChecked="{Binding RecordEdges}" Margin="0,0,0,8"
                                                  ToolTip="Saves every signal level duration while reading, for protocol research"/>
                                        <WrapPanel>
                                            <Button AutomationProperties.Name="Import CarTester.ini" Command="{Binding ImportIniCommand}" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <c:VectorIcon Kind="Import"/>
                                                    <TextBlock Text="Import CarTester.ini" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button AutomationProperties.Name="Replay edge log" Command="{Binding ReplayEdgesCommand}" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <c:VectorIcon Kind="Play"/>
                                                    <TextBlock Text="Replay edge log" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ Рядок стану ═══ -->
        <DockPanel Grid.Row="2" Margin="16,3,16,6">
            <TextBlock DockPanel.Dock="Right" Text="{Binding LineStats}" Style="{StaticResource Caption}" FontWeight="Normal"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Counters}" Style="{StaticResource Caption}" FontWeight="Normal" Margin="0,0,24,0"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" FontWeight="Normal" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
