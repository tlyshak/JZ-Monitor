<Window x:Class="JzMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:JzMonitor.Controls"
        Title="{Binding Title}" Height="820" Width="1280" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="Новий запис" Command="{Binding NewCommand}"/>
                <MenuItem Header="Відкрити .ctr…" Command="{Binding OpenCommand}"/>
                <MenuItem Header="Зберегти .ctr…" Command="{Binding SaveCommand}"/>
                <Separator/>
                <MenuItem Header="Експорт CSV (усі байти)…" Command="{Binding ExportCsvCommand}"/>
                <MenuItem Header="Опис автомобіля і коментарі…" Command="{Binding VehicleCommand}"/>
                <Separator/>
                <MenuItem Header="Імпорт налаштувань з CarTester.ini…" Command="{Binding ImportIniCommand}"/>
                <MenuItem Header="Програти файл сирих фронтів…" Command="{Binding ReplayEdgesCommand}"/>
                <Separator/>
                <MenuItem Header="Вихід" Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <!-- Панель підключення -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="4">
            <WrapPanel>
                <TextBlock Style="{StaticResource Label}" Text="Порт:"/>
                <ComboBox Width="90" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" IsEnabled="{Binding IsRunning, Converter={x:Static c:Inverse.Bool}}"/>
                <Button Content="⟳" ToolTip="Оновити список портів" Command="{Binding RefreshPortsCommand}"/>
                <Button Content="{Binding StartText}" Command="{Binding StartCommand}" FontWeight="Bold" MinWidth="90"/>
                <Button Content="Демо" ToolTip="Симуляція сигналу ECU без автомобіля" Command="{Binding DemoCommand}"/>
                <Ellipse Width="14" Height="14" Margin="6,0" VerticalAlignment="Center" ToolTip="Кадр прийнято без помилок">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#BBB"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LinkOk}" Value="True"><Setter Property="Fill" Value="#2E7D32"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Separator Margin="6,2"/>
                <TextBlock Style="{StaticResource Label}" Text="Лінія:"/>
                <ComboBox Width="130" ItemsSource="{Binding LineModes}" SelectedIndex="{Binding LineIndex}"/>
                <CheckBox Content="Інверсія" IsChecked="{Binding Invert}" ToolTip="Якщо кабель інвертує сигнал (див. «Check The Cable On The Inversion» в оригіналі)"/>
                <CheckBox Content="DTR" IsChecked="{Binding Dtr}" ToolTip="Тримати DTR активним (живлення адаптера)"/>
                <CheckBox Content="RTS" IsChecked="{Binding Rts}" ToolTip="Тримати RTS активним (живлення адаптера)"/>
                <CheckBox Content="Писати сирі фронти" IsChecked="{Binding RecordEdges}" ToolTip="Зберігати тривалості рівнів у файл для аналізу протоколу"/>
                <Separator Margin="6,2"/>
                <CheckBox Content="Показувати приховане оригіналом" IsChecked="{Binding ShowHidden}"/>
            </WrapPanel>
        </Border>

        <!-- Рядок стану -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock Text="{Binding Status}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding LineStats}"/></StatusBarItem>
        </StatusBar>

        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="2*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="230" MinHeight="100"/>
            </Grid.RowDefinitions>

            <!-- Параметри -->
            <DockPanel Grid.Row="0" Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Margin="0,0,0,4">
                    <TextBlock Text="{Binding FrameInfo}" FontWeight="SemiBold" FontSize="14"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="◀" Click="Prev_Click"/>
                        <Button DockPanel.Dock="Right" Content="Видалити кадр" Command="{Binding DeleteFrameCommand}"/>
                        <Button DockPanel.Dock="Right" Content="★ Мітка" Command="{Binding ToggleMarkCommand}"/>
                        <CheckBox DockPanel.Dock="Right" Content="Слідкувати" IsChecked="{Binding Follow}"/>
                        <Button DockPanel.Dock="Right" Content="▶" Click="Next_Click"/>
                        <Slider Minimum="0" Maximum="{Binding MaxIndex}" Value="{Binding CurrentIndex}" IsSnapToTickEnabled="True"
                                TickFrequency="1" SmallChange="1" LargeChange="10" VerticalAlignment="Center" Margin="4,0"/>
                    </DockPanel>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Parameters}" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE" RowHeaderWidth="0"
                          SelectionMode="Single" FontSize="13">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HiddenInOriginal}" Value="True">
                                    <Setter Property="Background" Value="#FFF8E1"/>
                                    <Setter Property="ToolTip" Value="Цей біт/байт оригінальний CarTester не показував"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Графік" Width="55">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <CheckBox IsChecked="{Binding Charted, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                                        <Rectangle Width="10" Height="10" Margin="4,0,0,0" Fill="{Binding ColorBrush}"
                                                   Visibility="{Binding Charted, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Параметр" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Значення" Binding="{Binding Text}" Width="90" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Од." Binding="{Binding Unit}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Сире" Binding="{Binding Raw}" Width="150" IsReadOnly="True"
                                            FontFamily="Consolas" Foreground="#666"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Row="0" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- Права панель: налаштування + сирі кадри -->
            <DockPanel Grid.Row="0" Grid.Column="2">
                <GroupBox DockPanel.Dock="Top" Header="Датчики (як у CarTester)" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="Повітря (5):"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AirModes}" SelectedIndex="{Binding AirIndex}"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Клапан ХХ (3):"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding IacModes}" SelectedIndex="{Binding IacIndex}"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Дросель (7):"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ThrottleModes}" SelectedIndex="{Binding ThrottleIndex}"/>
                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Байти 9/10:"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AfModes}" SelectedIndex="{Binding AfIndex}"/>
                        <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="Пряма шкала температури ОР (інакше 255−x)" IsChecked="{Binding CoolantDirect}"/>
                        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Label}" Text="Форсунки: прод."/>
                            <TextBox Width="40" Text="{Binding InjectorFlow}"/>
                            <TextBlock Style="{StaticResource Label}" Text="к-сть"/>
                            <TextBox Width="30" Text="{Binding InjectorCount}"/>
                            <TextBlock Style="{StaticResource Label}" Text="част."/>
                            <TextBox Width="30" Text="{Binding InjectionRate}"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
                <GroupBox DockPanel.Dock="Top" Header="Протокол" Padding="4">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Label}" Text="Біт, мс:"/>
                            <TextBox Width="50" Text="{Binding BitTimeMs}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Пауза, біт:"/>
                            <TextBox Width="35" Text="{Binding GapBits}"/>
                            <TextBlock Style="{StaticResource Label}" Text="Мін. байтів:"/>
                            <TextBox Width="35" Text="{Binding MinDataBytes}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding IdInfo}" FontFamily="Consolas" Margin="4,4,4,0"/>
                        <TextBlock Text="{Binding HexInfo}" FontFamily="Consolas" Margin="4,2" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Прийняті кадри (новіші зверху)" Padding="2">
                    <ListBox ItemsSource="{Binding RawLog}" FontFamily="Consolas" FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                </GroupBox>
            </DockPanel>

            <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Height="5" HorizontalAlignment="Stretch"/>

            <c:ChartControl x:Name="Chart" Grid.Row="2" Grid.ColumnSpan="3"
                            Series="{Binding Chart}" CursorIndex="{Binding ChartCursor, Mode=OneWay}"/>
        </Grid>
    </DockPanel>
</Window>
