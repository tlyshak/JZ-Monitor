<!--
  Інсталятор JZ Monitor (WiX 5, .msi). Збирається скриптом installer/build.ps1.
  - Для поточного користувача, без прав адміністратора: %LOCALAPPDATA%\Programs\JZ Monitor
    (тека записувана — налаштування JzMonitor.settings.json лежать поруч з exe, як і раніше).
  - .NET не входить: потрібен .NET 10 Desktop Runtime (без нього exe сам покаже, що встановити).
  - Ярлики в меню Пуск і на робочому столі; нова версія замінює стару (MajorUpgrade).
  Змінні з build.ps1: Version, PublishDir, IconPath.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="JZ Monitor" Manufacturer="tlyshak" Version="$(Version)"
           UpgradeCode="73b60538-1b20-4646-a589-1aa43dc39b33" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of JZ Monitor is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/tlyshak/JZ-Monitor" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="JZ Monitor" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- Файли в профілі користувача: ключ компонента — значення в HKCU (вимога Windows Installer) -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="fea91560-1105-470d-8d3c-af4a5630b8ea">
        <File Id="JzMonitorExe" Source="$(PublishDir)\JzMonitor.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\JZ Monitor" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts">
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
        <Shortcut Id="StartMenuJzMonitor" Name="JZ Monitor" Description="Toyota OBD-1 live data"
                  Target="[INSTALLFOLDER]JzMonitor.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\JZ Monitor" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcut" Directory="DesktopFolder">
        <Shortcut Id="DesktopJzMonitor" Name="JZ Monitor" Description="Toyota OBD-1 live data"
                  Target="[INSTALLFOLDER]JzMonitor.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\JZ Monitor" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>
  </Package>
</Wix>
